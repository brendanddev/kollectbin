<!DOCTYPE html>

<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{{title}}</title>
        {{>styles}}
    </head>

    <body>
        {{> nav}}
        <div class="container">
            <h1>{{title}}</h1>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th class="num">ID</th>
                            <th>Title</th>
                            <th class="num">Volume</th>
                            <th class="num">Issue</th>
                            <th>Author</th>
                            <th>Publisher</th>
                            <th class="num">Year</th>
                            <th>Genre</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#allComics}}
                        <tr>
                            <td class="num muted">{{id}}</td>
                            <td><strong>{{title}}</strong></td>
                            <td class="num">{{volume}}</td>
                            <td class="num">#{{issue}}</td>
                            <td>{{author}}</td>
                            <td>{{publisher}}</td>
                            <td class="num">{{#year}}{{year}}{{/year}}{{^year}}<span class="muted">-</span>{{/year}}</td>
                            <td><span class="badge">{{genre}}</span></td>
                        </tr>
                        {{/allComics}}
                    </tbody>
                </table>

                {{^allComics}}
                <div class="empty">No comics yet.</div>
                {{/allComics}}
            </div>
        </div>

        <hr>
        
        <div class="container">
            <h3>Add a New Comic</h3>
            <form>
                <label for="title">Title:</label><br>
                <input type="text" id="title" name="title"><br>

                <label for="volume">Volume:</label><br>
                <input type="number" id="volume" name="volume"><br>

                <label for="issue">Issue:</label><br>
                <input type="number" id="issue" name="issue"><br>

                <label for="author">Author:</label><br>
                <input type="text" id="author" name="author"><br>

                <label for="publisher">Publisher:</label><br>
                <input type="text" id="publisher" name="publisher"><br>

                <label for="year">Year:</label><br>
                <input type="number" id="year" name="year"><br>

                <label for="genre">Genre:</label><br>
                <input type="text" id="genre" name="genre"><br>

                <input type="submit" value="Submit">

            </form>
        </div>

    </body>
</html>
