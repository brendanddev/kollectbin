<!DOCTYPE html>

<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{{title}}</title>
        <style>
            :root {
                --bg: #f5f6fa;
                --card: #ffffff;
                --text: #1f2430;
                --muted: #6b7280;
                --accent: #d62839;
                --border: #e5e7eb;
                --stripe: #f9fafb;
            }

            @media (prefers-color-scheme: dark) {
                :root {
                    --bg: #12141a;
                    --card: #1b1e27;
                    --text: #e8eaf0;
                    --muted: #9aa0ae;
                    --border: #2c303c;
                    --stripe: #20232d;
                }
            }

            * { box-sizing: border-box; }

            body {
                margin: 0;
                padding: 32px 16px;
                font-family: system-ui, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
                background: var(--bg);
                color: var(--text);
            }

            .container { max-width: 960px; margin: 0 auto; }

            h1 { margin: 0 0 4px; font-size: 28px; }
            h2 { margin: 0 0 20px; font-size: 16px; font-weight: 500; color: var(--muted); }

            .table-wrap {
                background: var(--card);
                border: 1px solid var(--border);
                border-radius: 10px;
                overflow-x: auto;  /* table scrolls sideways on small screens */
            }

            table { width: 100%; border-collapse: collapse; }

            th, td { padding: 12px 14px; text-align: left; white-space: nowrap; }

            th {
                font-size: 12px;
                text-transform: uppercase;
                letter-spacing: 0.04em;
                color: var(--muted);
                border-bottom: 2px solid var(--accent);
            }

            td { border-bottom: 1px solid var(--border); }
            tbody tr:nth-child(even) { background: var(--stripe); }
            tbody tr:hover { background: rgba(214, 40, 57, 0.08); }
            tbody tr:last-child td { border-bottom: none; }

            .num { text-align: right; font-variant-numeric: tabular-nums; }
            .muted { color: var(--muted); }

            .badge {
                display: inline-block;
                padding: 2px 10px;
                border-radius: 999px;
                font-size: 12px;
                background: rgba(214, 40, 57, 0.12);
                color: var(--accent);
            }

            .empty { padding: 32px; text-align: center; color: var(--muted); }
        </style>
    </head>

    <body>
        {{> nav}}
        <div class="container">
            <h1>{{title}}</h1>
            <h2>Comics</h2>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th class="num">ID</th>
                            <th>Title</th>
                            <th class="num">Volume</th>
                            <th class="num">Issue</th>
                            <th>Author</th>
                            <th>Publisher</th>
                            <th class="num">Year</th>
                            <th>Genre</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#allComics}}
                        <tr>
                            <td class="num muted">{{id}}</td>
                            <td><strong>{{title}}</strong></td>
                            <td class="num">{{volume}}</td>
                            <td class="num">#{{issue}}</td>
                            <td>{{author}}</td>
                            <td>{{publisher}}</td>
                            <td class="num">{{#year}}{{year}}{{/year}}{{^year}}<span class="muted">-</span>{{/year}}</td>
                            <td><span class="badge">{{genre}}</span></td>
                        </tr>
                        {{/allComics}}
                    </tbody>
                </table>

                {{^allComics}}
                <div class="empty">No comics yet.</div>
                {{/allComics}}
            </div>
        </div>

        <hr>
        
        <div class="container">
            <h3>Add a New Comic</h3>
            <form>
                <label for="title">Title:</label><br>
                <input type="text" id="title" name="title"><br>

                <label for="volume">Volume:</label><br>
                <input type="number" id="volume" name="volume"><br>

                <label for="issue">Issue:</label><br>
                <input type="number" id="issue" name="issue"><br>

                <label for="author">Author:</label><br>
                <input type="text" id="author" name="author"><br>

                <label for="publisher">Publisher:</label><br>
                <input type="text" id="publisher" name="publisher"><br>

                <label for="year">Year:</label><br>
                <input type="number" id="year" name="year"><br>

                <label for="genre">Genre:</label><br>
                <input type="text" id="genre" name="genre"><br>

                <input type="submit" value="Submit">

            </form>
        </div>

    </body>
</html>
