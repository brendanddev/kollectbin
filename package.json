{
  "name": "kollectbin",
  "version": "0.3.0",
  "description": "A personal collection API for comics.",
  "main": "server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "migrate:create": "node-pg-migrate create --migrations-dir src/db/migrations",
    "migrate:up": "node-pg-migrate up --migrations-dir src/db/migrations",
    "migrate:down": "node-pg-migrate down --migrations-dir src/db/migrations",

    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brendanddev/kollectbin.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/brendanddev/kollectbin/issues"
  },
  "homepage": "https://github.com/brendanddev/kollectbin#readme",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0"
  }
}
