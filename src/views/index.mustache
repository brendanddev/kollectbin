<!DOCTYPE html>

<html>
    <head>
        <title>{{title}}</title>
        <style>
            td { border: 1px solid black }
        </style>
    </head>

    <body>
        <h1>{{title}}</h1>
        <h2>Comics</h2>

        <table>
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Volume</th>
                <th>Issue</th>
                <th>Author</th>
                <th>Publisher</th>
                <th>Year</th>
                <th>Genre</th>
            </tr>
            {{#allComics}}
            <tr>
                <td>{{id}}</td>
                <td>{{title}}</td>
                <td>{{volume}}</td>
                <td>{{issue}}</td>
                <td>{{author}}</td>
                <td>{{publisher}}</td>
                <td>{{year}}</td>
                <td>{{genre}}</td>
            </tr>
            {{/allComics}}
        </table>
    </body>
</html>
